{
  "name": "mangacn",
  "version": "0.0.1",
  "private": true,
  "description": "Manga-styled React components, distributed as a shadcn registry.",
  "homepage": "https://mangacn.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/fldx-dev/mangacn"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "predev": "pnpm registry:build && pnpm gen:theme && pnpm gen:demos",
    "dev": "next dev",
    "prebuild": "pnpm registry:build && pnpm gen:theme && pnpm gen:demos && pnpm gen:docs --check && pnpm gen:props --check",
    "build": "next build",
    "start": "next start",
    "registry:build": "shadcn build --output public/r",
    "registry:validate": "shadcn registry validate",
    "registry:smoke": "tsx scripts/registry-smoke.ts",
    "registry:smoke:changed": "tsx scripts/registry-smoke.ts --changed",
    "registry:list": "shadcn list http://localhost:3000/r/registry.json",
    "gen:theme": "tsx scripts/gen-theme-css.ts",
    "gen:demos": "tsx scripts/gen-demos.ts",
    "gen:docs": "tsx scripts/gen-docs.ts",
    "gen:props": "tsx scripts/gen-props.ts",
    "gen:skill": "tsx scripts/gen-skill.ts",
    "skill:validate": "tsx scripts/skill-validate.ts",
    "gen:parity": "tsx scripts/gen-parity-snapshot.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm gen:demos && pnpm typecheck && pnpm test",
    "check:changed": "tsx scripts/lint-changed.ts && pnpm gen:demos && pnpm typecheck && pnpm test:changed",
    "check:catalog": "tsx scripts/check-catalog.ts",
    "test": "vitest run --coverage.enabled=false",
    "test:changed": "vitest run --coverage.enabled=false --changed origin/main",
    "test:coverage": "vitest run",
    "test:watch": "vitest --coverage.enabled=false",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:changed": "tsx scripts/changed-e2e.ts --run",
    "test:e2e:update": "playwright test -c e2e/playwright.config.ts --update-snapshots=all",
    "ci": "pnpm run ci:checks && pnpm registry:smoke",
    "ci:checks": "pnpm lint && pnpm gen:demos && pnpm gen:docs --check && pnpm gen:props --check && pnpm gen:skill --check && pnpm skill:validate && pnpm typecheck && pnpm gen:theme && pnpm test:coverage && pnpm registry:validate && pnpm registry:build",
    "ci:smoke": "pnpm registry:build && pnpm registry:smoke"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@modelcontextprotocol/server": "2.4.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "^1.1.1",
    "cn": "0.5.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-typescript": "5.6.0",
    "fumadocs-ui": "16.17.9",
    "input-otp": "^1.5.0",
    "lucide-react": "1.64.0",
    "motion": "14.7.1",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.21.0",
    "recharts": "3.8.0",
    "roughjs": "4.6.6",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "vitest-axe": "0.1.0"
  }
}
