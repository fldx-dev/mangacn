{
  "name": "mangacn",
  "version": "0.0.1",
  "private": true,
  "description": "Manga-styled React components, distributed as a shadcn registry.",
  "homepage": "https://mangacn.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/fldx-dev/mangacn"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "pnpm registry:build",
    "dev": "next dev",
    "prebuild": "pnpm registry:build",
    "build": "next build",
    "start": "next start",
    "registry:build": "shadcn build --output public/r",
    "registry:validate": "shadcn registry validate",
    "registry:smoke": "tsx scripts/registry-smoke.ts",
    "registry:list": "shadcn list http://localhost:3000/r/registry.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --coverage.enabled=false"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.9",
    "lucide-react": "1.64.0",
    "motion": "14.7.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
