{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/ink-frame": ["./registry/theme/ink-frame/ink-frame.tsx"],
      "@/components/ui/button": ["./registry/ui/button/button.tsx"],
      "@/components/ui/toggle": ["./registry/ui/toggle/toggle.tsx"],
      "@/components/ui/input": ["./registry/ui/input/input.tsx"],
      "@/components/ui/textarea": ["./registry/ui/textarea/textarea.tsx"],
      "@/components/ui/dropdown-menu": ["./registry/ui/dropdown-menu/dropdown-menu.tsx"],
      "@/components/sfx-text": ["./registry/ui/sfx-text/sfx-text.tsx"],
      "@/components/ui/separator": ["./registry/ui/separator/separator.tsx"],
      "@/components/ui/label": ["./registry/ui/label/label.tsx"],
      "@/components/ui/item": ["./registry/ui/item/item.tsx"],
      "@/components/ui/kbd": ["./registry/ui/kbd/kbd.tsx"],
      "@/components/manga-frame": ["./registry/ui/manga-frame/manga-frame.tsx"],
      "@/components/page-number": ["./registry/ui/page-number/page-number.tsx"],
      "@/components/page-turn": ["./registry/ui/page-turn/page-turn.tsx"],
      "@/components/caption-box": ["./registry/ui/caption-box/caption-box.tsx"],
      "@/components/ink-mark": ["./registry/ui/ink-mark/ink-mark.tsx"],
      "@/components/stamp": ["./registry/ui/stamp/stamp.tsx"],
      "@/components/emanata": ["./registry/ui/emanata/emanata.tsx"],
      "@/components/ui/sheet": ["./registry/ui/sheet/sheet.tsx"],
      "@/components/ui/skeleton": ["./registry/ui/skeleton/skeleton.tsx"],
      "@/components/ui/tooltip": ["./registry/ui/tooltip/tooltip.tsx"],
      "@/components/ui/card": ["./registry/ui/card/card.tsx"],
      "@/hooks/use-mobile": ["./registry/hooks/use-mobile.ts"],
      "@/components/ui/input-group": ["./registry/ui/input-group/input-group.tsx"],
      "@/components/ui/dialog": ["./registry/ui/dialog/dialog.tsx"],
      "@/components/speech-bubble": ["./registry/ui/speech-bubble/speech-bubble.tsx"],
      "@/components/power-gauge": ["./registry/ui/power-gauge/power-gauge.tsx"],
      "@/components/panel-grid": ["./registry/ui/panel-grid/panel-grid.tsx"],
      "@/components/ui/aspect-ratio": ["./registry/ui/aspect-ratio/aspect-ratio.tsx"],
      "@/components/ui/drawer": ["./registry/ui/drawer/drawer.tsx"],
      "@/components/ui/progress": ["./registry/ui/progress/progress.tsx"],
      "@/components/blocks/*": ["./registry/blocks/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
