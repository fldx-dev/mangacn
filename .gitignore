# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# shadcn registry build output (built in CI / on deploy)
/public/r/

# generated from the theme registry item (pnpm gen:theme)
/app/mangacn-theme.css
/app/mangacn-presets.css

# local test-runner reports (rtk wraps vitest with a json reporter)
/.vitest/

# generated from registry/**/demos (pnpm gen:demos): the demo map and list, and one static
# route per page block, item gallery and demo stage (every folder under app/view and app/demo)
/lib/registry/demos.generated.ts
/lib/registry/demo-list.generated.ts
/app/view/*/
/app/demo/*/

# Playwright output (baselines in e2e/__screenshots__ are committed)
/e2e/test-results/
/playwright-report/

# generated by fumadocs-mdx (postinstall, next dev/build)
/.source/
