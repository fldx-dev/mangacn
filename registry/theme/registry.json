{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "mangacn theme",
      "description": "Ink-on-paper tokens, screentone utilities and impact keyframes for manga-styled UIs.",
      "categories": ["decoration"],
      "meta": {
        "since": "0.1.0"
      },
      "docs": "npx shadcn@latest add @mangacn/theme installs the fonts too: font-display, font-dialogue and font-dialogue-ja (or set --font-display / --font-dialogue-latin / --font-dialogue-ja yourself). Name only the theme: listing the font items in the same add loads each font into layout.tsx twice. Components install @mangacn/ink-frame, which draws their outlines, on their own.",
      "registryDependencies": [
        "https://www.mangacn.com/r/font-display.json",
        "https://www.mangacn.com/r/font-dialogue.json",
        "https://www.mangacn.com/r/font-dialogue-ja.json"
      ],
      "files": [],
      "cssVars": {
