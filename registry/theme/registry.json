          "font-display": "var(--font-display, \"Dela Gothic One\", \"Reggae One\", Impact, \"Arial Black\", sans-serif)",
          "font-dialogue": "var(--font-dialogue-latin, \"Shantell Sans\"), var(--font-dialogue-ja, \"Yusei Magic\"), \"Patrick Hand SC\", \"Comic Neue\", cursive, sans-serif",
