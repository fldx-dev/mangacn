      "meta": {
        "since": "0.1.0"
      },
      "docs": "Yusei Magic loads with subsets: ['latin'] because next/font lists only latin and latin-ext for it; Google's CSS still ships every unicode-range slice, so kana and kanji load as a page uses them.",
      "files": [],
      "font": {
        "family": "Yusei Magic",
