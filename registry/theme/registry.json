{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "mangacn theme",
      "description": "Ink-on-paper tokens, screentone utilities and impact keyframes for manga-styled UIs.",
      "categories": ["decoration"],
      "meta": {
        "since": "0.1.0"
      },
      "docs": "Fonts are separate items: npx shadcn@latest add @mangacn/font-display @mangacn/font-dialogue (or set --font-display / --font-dialogue yourself). Outlined components draw through @mangacn/ink-frame: add it before them.",
      "files": [],
      "cssVars": {
        "theme": {
          "font-display": "var(--font-display, \"Dela Gothic One\", \"Reggae One\", Impact, \"Arial Black\", sans-serif)",
          "font-dialogue": "var(--font-dialogue, \"Shantell Sans\", \"Patrick Hand SC\", \"Comic Neue\", cursive, sans-serif)",
          "color-ink": "var(--ink)",
          "color-paper": "var(--paper)",
          "color-spot": "var(--spot)",
          "color-spot-foreground": "var(--spot-foreground)",
          "color-tone-1": "var(--tone-1)",
          "color-tone-2": "var(--tone-2)",
          "color-tone-3": "var(--tone-3)",
          "color-tone-4": "var(--tone-4)",
          "outline-width": "1.5px",
          "outline-width-heavy": "2.1px",
          "ink-roughness": "1.2",
          "ink-bowing": "0.8",
          "ink-offset": "1.5",
          "ink-hachure-gap": "4px",
          "shadow-offset": "4px",
          "halftone-size": "4px",
          "halftone-dot": "1.2px",
          "speed-line-width": "2px"
        },
        "light": {
          "ink": "oklch(0.16 0.005 60)",
          "paper": "oklch(0.985 0.008 85)",
          "spot": "oklch(0.57 0.22 27)",
          "spot-foreground": "oklch(0.985 0.008 85)",
          "tone-1": "oklch(0.93 0 0)",
          "tone-2": "oklch(0.82 0 0)",
          "tone-3": "oklch(0.55 0 0)",
          "tone-4": "oklch(0.42 0 0)",
          "background": "var(--paper)",
          "foreground": "var(--ink)",
          "card": "var(--paper)",
          "card-foreground": "var(--ink)",
          "popover": "var(--paper)",
          "popover-foreground": "var(--ink)",
          "primary": "var(--ink)",
          "primary-foreground": "var(--paper)",
          "secondary": "var(--tone-1)",
          "secondary-foreground": "var(--ink)",
          "muted": "var(--tone-1)",
          "muted-foreground": "var(--tone-3)",
          "accent": "var(--tone-1)",
          "accent-foreground": "var(--ink)",
          "destructive": "var(--spot)",
          "border": "var(--ink)",
          "input": "var(--ink)",
          "ring": "var(--spot)",
          "chart-1": "var(--ink)",
          "chart-2": "var(--tone-4)",
          "chart-3": "var(--tone-3)",
          "chart-4": "var(--tone-2)",
          "chart-5": "var(--spot)",
          "sidebar": "var(--paper)",
          "sidebar-foreground": "var(--ink)",
          "sidebar-primary": "var(--ink)",
          "sidebar-primary-foreground": "var(--paper)",
          "sidebar-accent": "var(--tone-1)",
          "sidebar-accent-foreground": "var(--ink)",
          "sidebar-border": "var(--ink)",
          "sidebar-ring": "var(--spot)",
          "radius": "0.125rem"
        },
        "dark": {
          "ink": "oklch(0.93 0.004 85)",
          "paper": "oklch(0.24 0.004 60)",
          "spot": "oklch(0.66 0.21 27)",
          "spot-foreground": "oklch(0.24 0.004 60)",
          "tone-1": "oklch(0.31 0 0)",
          "tone-2": "oklch(0.42 0 0)",
          "tone-3": "oklch(0.62 0 0)",
          "tone-4": "oklch(0.73 0 0)",
          "background": "var(--paper)",
          "foreground": "var(--ink)",
          "card": "var(--paper)",
          "card-foreground": "var(--ink)",
          "popover": "var(--paper)",
          "popover-foreground": "var(--ink)",
          "primary": "var(--ink)",
          "primary-foreground": "var(--paper)",
          "secondary": "var(--tone-1)",
          "secondary-foreground": "var(--ink)",
          "muted": "var(--tone-1)",
          "muted-foreground": "var(--tone-3)",
          "accent": "var(--tone-1)",
          "accent-foreground": "var(--ink)",
          "destructive": "var(--spot)",
          "border": "var(--ink)",
          "input": "var(--ink)",
          "ring": "var(--spot)",
          "chart-1": "var(--ink)",
          "chart-2": "var(--tone-4)",
          "chart-3": "var(--tone-3)",
          "chart-4": "var(--tone-2)",
          "chart-5": "var(--spot)",
          "sidebar": "var(--paper)",
          "sidebar-foreground": "var(--ink)",
          "sidebar-primary": "var(--ink)",
          "sidebar-primary-foreground": "var(--paper)",
          "sidebar-accent": "var(--tone-1)",
          "sidebar-accent-foreground": "var(--ink)",
          "sidebar-border": "var(--ink)",
          "sidebar-ring": "var(--spot)",
          "radius": "0.125rem"
        }
      },
      "css": {
        "@utility halftone": {
          "background-image": "radial-gradient(circle, var(--tone-4) var(--halftone-dot), transparent calc(var(--halftone-dot) + 0.5px))",
          "background-size": "var(--halftone-size) var(--halftone-size)"
        },
        "@utility halftone-light": {
          "background-image": "radial-gradient(circle, var(--tone-2) var(--halftone-dot), transparent calc(var(--halftone-dot) + 0.5px))",
          "background-size": "var(--halftone-size) var(--halftone-size)"
        },
        "@utility halftone-dark": {
          "background-image": "radial-gradient(circle, var(--ink) var(--halftone-dot), transparent calc(var(--halftone-dot) + 0.5px))",
          "background-size": "var(--halftone-size) var(--halftone-size)"
        },
        "@utility screentone-lines": {
          "background-image": "repeating-linear-gradient(45deg, var(--tone-4) 0 1px, transparent 1px 5px)"
        },
        "@utility screentone-cross": {
          "background-image": "repeating-linear-gradient(45deg, var(--tone-4) 0 1px, transparent 1px 5px), repeating-linear-gradient(-45deg, var(--tone-4) 0 1px, transparent 1px 5px)"
        },
        "@utility speed-lines": {
          "background-image": "repeating-conic-gradient(from 0deg at 50% 50%, var(--ink) 0deg 0.6deg, transparent 0.6deg 6deg)",
          "-webkit-mask-image": "radial-gradient(circle at 50% 50%, transparent 22%, black 70%)",
          "mask-image": "radial-gradient(circle at 50% 50%, transparent 22%, black 70%)"
        },
        "@utility ink-border": {
          "border": "var(--outline-width) solid var(--ink)"
        },
        "@utility ink-border-heavy": {
          "border": "var(--outline-width-heavy) solid var(--ink)"
        },
        "@utility ink-shadow": {
          "box-shadow": "var(--shadow-offset) var(--shadow-offset) 0 0 var(--ink)"
        },
        "@utility ink-shadow-sm": {
          "box-shadow": "calc(var(--shadow-offset) / 2) calc(var(--shadow-offset) / 2) 0 0 var(--ink)"
        },
        "@utility ink-shadow-spot": {
          "box-shadow": "var(--shadow-offset) var(--shadow-offset) 0 0 var(--spot)"
        },
        "@utility paper-grain": {
          "background-image": "radial-gradient(color-mix(in oklch, var(--ink) 7%, transparent) 0.5px, transparent 0.75px), radial-gradient(color-mix(in oklch, var(--ink) 5%, transparent) 0.5px, transparent 0.75px), radial-gradient(color-mix(in oklch, var(--ink) 4%, transparent) 0.5px, transparent 0.75px)",
          "background-size": "3px 3px, 5px 7px, 11px 13px",
          "background-position": "0 0, 1px 2px, 3px 5px"
        },
        "@keyframes mangacn-shake": {
          "0%, 100%": {
            "transform": "translateX(0)"
          },
          "25%": {
            "transform": "translateX(-4px)"
          },
          "75%": {
            "transform": "translateX(4px)"
          }
        },
        "@keyframes mangacn-pop": {
          "0%": {
            "opacity": "0",
            "transform": "scale(0.6)"
          },
          "60%": {
            "opacity": "1",
            "transform": "scale(1.08)"
          },
          "100%": {
            "opacity": "1",
            "transform": "scale(1)"
          }
        },
        "@keyframes mangacn-slam": {
          "0%": {
            "opacity": "0",
            "transform": "scale(1.4) translateY(0)"
          },
          "70%": {
            "opacity": "1",
            "transform": "scale(1) translateY(2px)"
          },
          "100%": {
            "opacity": "1",
            "transform": "scale(1) translateY(0)"
          }
        },
        "@keyframes mangacn-flash": {
          "0%, 100%": {
            "opacity": "1"
          },
          "50%": {
            "opacity": "0.2"
          }
        },
        "@keyframes mangacn-speed-in": {
          "0%": {
            "opacity": "0",
            "transform": "translateX(24px) skewX(-12deg)"
          },
          "100%": {
            "opacity": "1",
            "transform": "translateX(0) skewX(0)"
          }
        },
        "@utility animate-mangacn-shake": {
          "animation": "mangacn-shake 0.12s ease-in-out 3"
        },
        "@utility animate-mangacn-pop": {
          "animation": "mangacn-pop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) both"
        },
        "@utility animate-mangacn-slam": {
          "animation": "mangacn-slam 0.28s cubic-bezier(0.2, 0.8, 0.2, 1) both"
        },
        "@utility animate-mangacn-flash": {
          "animation": "mangacn-flash 0.4s ease-in-out"
        },
        "@utility animate-mangacn-speed-in": {
          "animation": "mangacn-speed-in 0.24s cubic-bezier(0.2, 0.8, 0.2, 1) both"
        },
        "@media (prefers-reduced-motion: reduce)": {
          "[class*=\"animate-mangacn-\"]": {
            "animation": "none"
          }
        },
        "@layer base": {
          "*": {
            "@apply border-border outline-ring/50": {}
          },
          "body": {
            "@apply bg-background text-foreground": {}
          }
        }
      }
    },
    {
      "name": "font-display",
      "type": "registry:font",
      "title": "Dela Gothic One",
      "description": "Ultra-bold gothic display face for SFX and headings, exposed as --font-display.",
      "categories": ["text"],
      "meta": {
        "since": "0.1.0"
      },
      "files": [],
      "font": {
        "family": "Dela Gothic One",
        "provider": "google",
        "import": "Dela_Gothic_One",
        "variable": "--font-display",
        "weight": ["400"],
        "subsets": ["latin", "latin-ext"]
      }
    },
    {
      "name": "font-dialogue",
      "type": "registry:font",
      "title": "Shantell Sans",
      "description": "Hand-drawn variable sans for speech bubbles and dialogue, exposed as --font-dialogue.",
      "categories": ["text"],
      "meta": {
        "since": "0.1.0"
      },
      "files": [],
      "font": {
        "family": "Shantell Sans",
        "provider": "google",
        "import": "Shantell_Sans",
        "variable": "--font-dialogue",
        "subsets": ["latin", "latin-ext"]
      }
    },
    {
      "name": "manga-motion",
      "type": "registry:lib",
      "title": "Manga motion presets",
      "description": "Spring and easing presets plus popIn, slamIn, shake and flash variants for motion.",
      "categories": ["animation"],
      "meta": {
        "since": "0.1.0"
      },
      "dependencies": ["motion"],
      "files": [
        {
          "path": "manga-motion/manga-motion.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "ink-frame",
      "type": "registry:component",
      "title": "Ink frame",
      "description": "Hand-drawn rough.js outline, fill and optional shadow behind any element; every outlined mangacn item uses it.",
      "categories": ["decoration"],
      "meta": {
        "since": "0.1.0"
      },
      "dependencies": ["roughjs@4.6.6"],
      "files": [
        {
          "path": "ink-frame/ink-frame.tsx",
          "type": "registry:component",
          "target": "@components/ink-frame.tsx"
        }
      ]
    }
  ]
}
