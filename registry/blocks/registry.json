{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "chapter-list",
      "type": "registry:block",
      "title": "Chapter List",
      "description": "Chapter index for a series: one item row per chapter, read titles struck through, the latest stamped; Latin or Japanese numerals.",
      "categories": ["block"],
      "meta": {
        "since": "0.1.0"
      },
      "dependencies": ["cn"],
      "registryDependencies": [
        "https://www.mangacn.com/r/caption-box.json",
        "https://www.mangacn.com/r/ink-mark.json",
        "https://www.mangacn.com/r/stamp.json",
        "https://www.mangacn.com/r/separator.json",
        "https://www.mangacn.com/r/item.json"
      ],
      "files": [
        {
          "path": "chapter-list/chapter-list.tsx",
          "type": "registry:block",
          "target": "@components/blocks/chapter-list/chapter-list.tsx"
        },
        {
          "path": "chapter-list/chapter-numeral.ts",
          "type": "registry:block",
          "target": "@components/blocks/chapter-list/chapter-numeral.ts"
        }
      ]
    },
    {
      "name": "spread-viewer",
      "type": "registry:block",
      "title": "Spread Viewer",
      "description": "Two-page manga spread reader: facing pages in ink frames, folios, a page turn, buttons, arrow keys and swipe; right to left by default.",
      "categories": ["block"],
      "meta": {
        "since": "0.1.0"
      },
      "dependencies": ["cn", "lucide-react", "motion"],
      "registryDependencies": [
        "https://www.mangacn.com/r/manga-frame.json",
        "https://www.mangacn.com/r/page-number.json",
        "https://www.mangacn.com/r/page-turn.json",
        "https://www.mangacn.com/r/button.json",
        "https://www.mangacn.com/r/kbd.json"
      ],
      "files": [
        {
          "path": "spread-viewer/spread-viewer.tsx",
          "type": "registry:block",
          "target": "@components/blocks/spread-viewer/spread-viewer.tsx"
        },
        {
          "path": "spread-viewer/use-spread.ts",
          "type": "registry:block",
          "target": "@components/blocks/spread-viewer/use-spread.ts"
        }
      ]
    },
    {
      "name": "character-card",
      "type": "registry:block",
      "title": "Character Card",
      "description": "Cast entry: portrait in an ink frame with a status stamp, the name with its reading as ruby, role, a line of dialogue and stats as power gauges, on a card.",
      "categories": ["block"],
      "meta": {
        "since": "0.1.0"
      },
      "dependencies": ["cn"],
      "registryDependencies": [
        "https://www.mangacn.com/r/card.json",
        "https://www.mangacn.com/r/manga-frame.json",
        "https://www.mangacn.com/r/caption-box.json",
        "https://www.mangacn.com/r/speech-bubble.json",
        "https://www.mangacn.com/r/power-gauge.json",
        "https://www.mangacn.com/r/stamp.json"
      ],
      "files": [
        {
          "path": "character-card/character-card.tsx",
          "type": "registry:block",
          "target": "@components/blocks/character-card/character-card.tsx"
        }
      ]
    },
    {
      "name": "volume-grid",
      "type": "registry:block",
