      "dependencies": ["cn"],
      "registryDependencies": [
        "https://www.mangacn.com/r/panel-grid.json",
        "https://www.mangacn.com/r/manga-frame.json",
        "https://www.mangacn.com/r/aspect-ratio.json",
        "https://www.mangacn.com/r/page-number.json",
        "https://www.mangacn.com/r/stamp.json"
      ],
      "files": [
        {
          "path": "volume-grid/volume-grid.tsx",
          "type": "registry:block",
          "target": "@components/blocks/volume-grid/volume-grid.tsx"
        }
      ]
    }
  ]
}
